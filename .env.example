# FixMate AI — local environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Required: an OpenAI API key with access to the selected models.
OPENAI_API_KEY=

# Optional: override the text model used for diagnosis and chat.
OPENAI_MODEL=gpt-4o-mini

# Optional: override the vision-capable model used for image inspection.
# If omitted, OPENAI_MODEL is used (it must support image input).
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible gateway URL. Leave blank for the official API.
OPENAI_BASE_URL=

# Optional: store the SQLite database somewhere else.
# FIXMATE_DB_PATH=data/fixmate.db
